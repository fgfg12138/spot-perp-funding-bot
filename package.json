{
  "name": "funding-arbitrage-dashboard",
  "version": "0.5.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "v121:worker": "npx tsx scripts/v121-worker.ts",
    "v121:worker:dry": "cross-env V121_MODE=PAPER V121_DRY_RUN=1 npx tsx scripts/v121-worker.ts",
    "v121:worker:mainnet-tiny:dry": "cross-env V121_MODE=MAINNET_TINY V121_MAINNET_TINY_ENABLED=true V121_CONFIRM_MAINNET_TINY_RISK=I_UNDERSTAND V121_DRY_RUN=1 V121_ENABLE_REAL_INTERNAL_TRANSFER=0 V121_ENABLE_REAL_ORDER_EXECUTION=0 V121_REAL_ORDER_EXECUTION_ENABLED=0 npx tsx scripts/v121-worker.ts",
    "v121:smoke": "npx tsx scripts/v121-smoke-market.ts",
    "v121:shadow:diag": "npx tsx scripts/v121-shadow-diagnostics.ts",
    "v121:tiny:dry-check": "npx tsx scripts/v121-mainnet-tiny-dry-run-check.ts",
    "v121:verify": "npm run lint:i18n && npx tsc --noEmit -p tsconfig.ci.json && npx vitest run lib/strategy-v121 && npm run build",
    "v121:product-smoke": "npx tsx scripts/v121-product-smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
