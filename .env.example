# ─── V1.2.1 系统模式 ──────────────────────────
# 可选值: READ_ONLY | PAPER | SHADOW | MAINNET_TINY | CONTROLLED_LIVE
# 默认 READ_ONLY — 不会真实下单
V121_MODE=READ_ONLY

# ─── Kill Switch ──────────────────────────────
# 可选值: OFF | READ_ONLY_ONLY | PAUSE_NEW_ENTRIES | PAUSE_ALL_AUTOMATION
V121_KILL_SWITCH=OFF

# ─── MAINNET_TINY 主网极小资金验证 ──────────────
# 同时满足以下三个条件才可开启主网极小验证
V121_MAINNET_TINY_ENABLED=false
V121_CONFIRM_MAINNET_TINY_RISK=

# ─── CONTROLLED_LIVE 主网受控实盘 ──────────────
# 需在 MAINNET_TINY 验证稳定后才可开启
V121_LIVE_ENABLED=false
V121_CONFIRM_LIVE_RISK=

# ─── API Key（服务端只读，前端不可见）───────────
# MAINNET_TINY / CONTROLLED_LIVE 才需要真实 API Key
# SHADOW 需要只读 API Key
BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

HTX_API_KEY=
HTX_API_SECRET=
