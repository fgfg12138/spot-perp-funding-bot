# ─── V1.2.1 系统模式 ──────────────────────────
# 可选值: READ_ONLY | PAPER | SHADOW | MAINNET_TINY | CONTROLLED_LIVE
# 默认 READ_ONLY — 不会真实下单
V121_MODE=READ_ONLY

# ─── Kill Switch ──────────────────────────────
V121_KILL_SWITCH=OFF

# ─── MAINNET_TINY 主网极小资金验证 ──────────────
V121_MAINNET_TINY_ENABLED=false
V121_CONFIRM_MAINNET_TINY_RISK=

# ─── API Key ──────────────────────────────────
# 请在应用内设置页面填写你的交易所 API Key
BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ─── 交易所账户绑定主密钥 ────────────────────
V121_MASTER_KEY=V121_MASTER_SECRET_2026_L0cal_K3y_F0r_3ncrypt_Api
